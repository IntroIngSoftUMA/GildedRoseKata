<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <!-- Maven model version - always 4.0.0 for Maven 2 and 3 -->
  <modelVersion>4.0.0</modelVersion>

  <!-- Project coordinates for unique identification -->
  <groupId>org.iis2026</groupId>              <!-- Reverse domain name of the organization -->
  <artifactId>GildedRose</artifactId>        <!-- Name of the project/module -->
  <version>1.0-SNAPSHOT</version>             <!-- Version, with SNAPSHOT indicating it's a work in progress -->
  <packaging>jar</packaging>                  <!-- Packaging type - JAR for Java applications -->

  <!-- Project metadata -->
  <name>GildedRose</name>                    <!-- Human-readable project name -->
  <url>http://maven.apache.org</url>          <!-- Project website or repository URL -->

  <!-- Centralized project properties -->
  <properties>
    <!-- Java release version used by the compiler -->
    <maven.compiler.release>21</maven.compiler.release>

    <!-- Source file encoding -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- JUnit version managed as a property -->
    <junit.version>6.0.3</junit.version>
  </properties>

  <!-- Project dependencies -->
  <dependencies>
    <dependency>
      <!-- JUnit 6 testing framework  -->
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope> <!-- Available only during test phase -->
    </dependency>
  </dependencies>

  <!-- Build configuration -->
  <build>
    <plugins>

      <!-- Java compilation plugin -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
      </plugin>

      <!-- Test execution plugin (runs JUnit tests) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.5</version>
      </plugin>
    </plugins>
  </build>
</project>